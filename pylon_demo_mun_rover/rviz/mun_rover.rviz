Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded: []
    Splitter Ratio: 0.5833333134651184
  Tree Height: 650
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Ground traversability
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 5
    Alpha: 0.65
    Color Scheme: map
  - Class: rviz_default_plugins/Map
    Name: Local costs
    Enabled: false
    Topic:
      Value: /pylon/mun_rover/local_costmap/costmap
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 5
    Alpha: 0.65
    Color Scheme: costmap
  - Class: rviz_default_plugins/PointCloud2
    Name: 3D LiDAR
    Enabled: false
    Topic:
      Value: /pylon/mun_rover/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Size (m): 0.1
    Style: Points
    Color Transformer: FlatColor
    Color: 180; 190; 210
    Position Transformer: XYZ
  - Class: rviz_default_plugins/PointCloud2
    Name: Ground
    Enabled: false
    Topic:
      Value: /pylon/mun_rover/ground
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Size (m): 0.1
    Style: Points
    Color Transformer: FlatColor
    Color: 70; 220; 130
    Position Transformer: XYZ
  - Class: rviz_default_plugins/PointCloud2
    Name: Obstacles
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/obstacles
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Size (m): 0.1
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 60; 50
    Position Transformer: XYZ
  - Class: rviz_default_plugins/Path
    Name: Planned path
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
    Color: 60; 180; 255
    Line Style: Billboards
    Line Width: 0.1
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.15
  - Class: rviz_default_plugins/Path
    Name: Driven path
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/trajectory
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
    Color: 255; 210; 60
    Line Style: Billboards
    Line Width: 0.1
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.15
  - Class: rviz_default_plugins/Polygon
    Name: Rover footprint
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/local_costmap/published_footprint
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
    Color: 100; 180; 255
  - Class: rviz_default_plugins/Marker
    Name: Status
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/status_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
  - Class: rviz_default_plugins/RobotModel
    Name: Rover URDF
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /pylon/mun_rover/robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
    Update Interval: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Surface photos
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/photo_map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
    Position Transformer: XYZ
    Color Transformer: RGB8
    Style: Flat Squares
    Size (m): 0.1
    Alpha: 1
    Decay Time: 0
    Selectable: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35.0
      Pitch: 1.1
      Yaw: 3.14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: pylon_rover_base_footprint
      Name: Current View
      Value: Orbit (rviz_default_plugins)
Window Geometry:
  Height: 1500
  Width: 2200
  X: 80
  Y: 100
  Hide Left Dock: false
  Hide Right Dock: false
